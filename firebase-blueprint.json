{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private student profile, role, and gamified progress state",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_.-]+$" },
        "usernameLower": { "type": "string", "minLength": 3, "maxLength": 32 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "maxLength": 160 },
        "profileImage": { "type": "string", "maxLength": 500 },
        "preferredLanguage": { "type": "string", "enum": ["en", "ml", "hi", "ta"] },
        "targetPost": { "type": "string", "maxLength": 100 },
        "dailyGoalMinutes": { "type": "integer" },
        "xp": { "type": "integer" },
        "totalPoints": { "type": "integer" },
        "coins": { "type": "integer" },
        "streak": { "type": "integer" },
        "dailyStreak": { "type": "integer" },
        "totalStudyHours": { "type": "number" },
        "mockTestsCompleted": { "type": "integer" },
        "questionsAttempted": { "type": "integer" },
        "questionsCorrect": { "type": "integer" },
        "subjectStats": { "type": "object" },
        "level": { "type": "string", "maxLength": 40 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "isActive": { "type": "boolean" },
        "completedLessons": { "type": "array" },
        "earnedBadges": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "lastLogin": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "displayName", "preferredLanguage", "xp", "coins", "streak", "role"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Unique username reservation record containing no email PII",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "minLength": 3, "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Detailed per-user lesson, topic, and subject progress summary",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "completedLessonIds": { "type": "array" },
        "completedTopics": { "type": "array" },
        "subjectProgress": { "type": "object" },
        "totalStudyMinutes": { "type": "integer" },
        "lastStudiedAt": { "type": "string", "maxLength": 64 },
        "difficultQuestionIds": { "type": "array" },
        "revisionListIds": { "type": "array" },
        "pyqAttempts": { "type": "object" }
      },
      "required": ["uid", "completedLessonIds", "completedTopics", "totalStudyMinutes"]
    },
    "Subject": {
      "title": "Subject",
      "description": "SSC CGL core subject metadata",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 60 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 60 },
        "order": { "type": "integer" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["subjectId", "title", "order", "isPublished"]
    },
    "Course": {
      "title": "Course",
      "description": "Structured SSC CGL course module linked to a subject",
      "type": "object",
      "properties": {
        "courseId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 60 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 800 },
        "thumbnailUrl": { "type": "string", "maxLength": 500 },
        "order": { "type": "integer" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["courseId", "subjectId", "title", "isPublished"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Video lesson metadata (actual media hosted in Firebase Storage)",
      "type": "object",
      "properties": {
        "lessonId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "courseId": { "type": "string", "maxLength": 100 },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 60 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "thumbnailUrl": { "type": "string", "maxLength": 500 },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "duration": { "type": "integer" },
        "lessonOrder": { "type": "integer" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["lessonId", "subjectId", "title", "isPublished"]
    },
    "QuestionItem": {
      "title": "QuestionItem",
      "description": "SSC CGL PYQ or AI-generated practice question with strict verification provenance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "questionNumber": { "type": "integer" },
        "subject": { "type": "string", "maxLength": 60 },
        "topic": { "type": "string", "maxLength": 80 },
        "year": { "type": "integer" },
        "examDate": { "type": "string", "maxLength": 40 },
        "shift": { "type": "string", "maxLength": 80 },
        "tier": { "type": "string", "maxLength": 20 },
        "difficulty": { "type": "string", "maxLength": 20 },
        "sourceType": { "type": "string", "enum": ["PYQ", "AI_GENERATED"] },
        "sourceLabel": { "type": "string", "maxLength": 160 },
        "answerStatus": { "type": "string", "enum": ["official", "unofficial", "needs_verification"] },
        "isVerified": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "language": { "type": "string", "maxLength": 16 },
        "questionEn": { "type": "string", "maxLength": 1200 },
        "questionHi": { "type": "string", "maxLength": 1200 },
        "optionsEn": { "type": "array" },
        "correctIndex": { "type": "integer" },
        "explanations": { "type": "object" },
        "stepByStep": { "type": "array" },
        "shortcutMethod": { "type": "string", "maxLength": 800 },
        "sourceUrls": { "type": "array" }
      },
      "required": ["subject", "topic", "tier", "sourceType", "questionEn", "correctIndex", "isPublished"]
    },
    "MockTest": {
      "title": "MockTest",
      "description": "Timed SSC CGL mock test configuration",
      "type": "object",
      "properties": {
        "testId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "category": { "type": "string", "maxLength": 40 },
        "subjectIds": { "type": "array" },
        "questionIds": { "type": "array" },
        "durationMinutes": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "totalMarks": { "type": "number" },
        "marksPerCorrect": { "type": "number" },
        "negativeMarking": { "type": "number" },
        "description": { "type": "string", "maxLength": 600 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["testId", "title", "questionIds", "durationMinutes", "totalMarks", "isPublished"]
    },
    "TestAttempt": {
      "title": "TestAttempt",
      "description": "Completed mock test or quiz attempt record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "testId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "testTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "answers": { "type": "object" },
        "subjectBreakdown": { "type": "object" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "correctCount": { "type": "integer" },
        "wrongCount": { "type": "integer" },
        "unattemptedCount": { "type": "integer" },
        "accuracy": { "type": "number" },
        "timeTakenSec": { "type": "integer" },
        "startedAt": { "type": "string", "maxLength": 64 },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "testId", "testTitle", "score", "maxScore", "accuracy"]
    },
    "GameScore": {
      "title": "GameScore",
      "description": "Completed educational exam game score and accuracy record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "gameId": { "type": "string", "minLength": 1, "maxLength": 60 },
        "gameTitle": { "type": "string", "maxLength": 120 },
        "score": { "type": "integer" },
        "xpEarned": { "type": "integer" },
        "coinsEarned": { "type": "integer" },
        "accuracy": { "type": "number" },
        "completedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "gameId", "score", "accuracy", "completedAt"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "Completed educational game mode session",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "gameMode": { "type": "string", "minLength": 1, "maxLength": 60 },
        "score": { "type": "integer" },
        "xpEarned": { "type": "integer" },
        "coinsEarned": { "type": "integer" },
        "accuracy": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "gameMode", "score", "xpEarned", "coinsEarned"]
    },
    "AiTutorMessage": {
      "title": "AiTutorMessage",
      "description": "Stored AI Tutor chat message under aiTutorChats/{uid}/messages",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "language": { "type": "string", "enum": ["en", "ml", "hi", "ta"] }
      },
      "required": ["messageId", "role", "message", "timestamp", "language"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public gamified ranking entry without PII",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "xp": { "type": "integer" },
        "streak": { "type": "integer" },
        "level": { "type": "string", "maxLength": 40 },
        "accuracy": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "displayName", "xp", "streak", "level"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved question or video lesson bookmark",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "itemType": { "type": "string", "enum": ["question", "video"] },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "itemType", "itemId", "title"]
    },
    "StudyPlan": {
      "title": "StudyPlan",
      "description": "Personalized SSC CGL study plan",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hoursPerDay": { "type": "number" },
        "examTarget": { "type": "string", "maxLength": 80 },
        "examDate": { "type": "string", "maxLength": 40 },
        "preferredLanguage": { "type": "string", "enum": ["en", "ml", "hi", "ta"] },
        "blocks": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "hoursPerDay", "examTarget", "preferredLanguage"]
    },
    "VideoLesson": {
      "title": "VideoLesson",
      "description": "Admin-managed video lesson metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "maxLength": 160 },
        "subject": { "type": "string", "maxLength": 60 },
        "topic": { "type": "string", "maxLength": 80 },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["title", "subject", "topic"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Academy announcement published by admin",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "body": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "body"]
    },
    "OceanQuestMission": {
      "title": "OceanQuestMission",
      "description": "Admin-managed Ocean Quest underwater mission definition",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "locationId": { "type": "string", "minLength": 1, "maxLength": 60 },
        "locationOrder": { "type": "integer" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 500 },
        "mode": { "type": "string", "enum": ["treasure-hunt", "submarine-exploration", "crystal-rush", "boss-battle", "daily-challenge", "subject-mission"] },
        "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
        "subject": { "type": "string", "maxLength": 40 },
        "questionCount": { "type": "integer" },
        "timeLimitSec": { "type": "integer" },
        "minAccuracyPct": { "type": "integer" },
        "hintLimit": { "type": "integer" },
        "xpReward": { "type": "integer" },
        "coinReward": { "type": "integer" },
        "crystalReward": { "type": "integer" },
        "badgeId": { "type": "string", "maxLength": 80 },
        "prerequisiteMissionIds": { "type": "array" },
        "isBoss": { "type": "boolean" },
        "guardianName": { "type": "string", "maxLength": 100 },
        "isPublished": { "type": "boolean" },
        "order": { "type": "integer" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["missionId", "locationId", "title", "mode", "difficulty", "subject", "questionCount", "minAccuracyPct", "xpReward", "coinReward", "isPublished"]
    },
    "OceanQuestProgress": {
      "title": "OceanQuestProgress",
      "description": "Per-student Ocean Quest progression, unlocked locations, seen questions, and best scores",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "unlockedLocations": { "type": "array" },
        "completedMissions": { "type": "array" },
        "missionBestScores": { "type": "object" },
        "missionStars": { "type": "object" },
        "seenQuestionIds": { "type": "array" },
        "wrongQuestionIds": { "type": "array" },
        "crystals": { "type": "integer" },
        "totalQuestXp": { "type": "integer" },
        "questBadges": { "type": "array" },
        "dailyCompletions": { "type": "array" },
        "totalRuns": { "type": "integer" },
        "totalCorrect": { "type": "integer" },
        "totalAttempted": { "type": "integer" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "unlockedLocations", "completedMissions", "crystals", "totalQuestXp"]
    },
    "OceanQuestClaim": {
      "title": "OceanQuestClaim",
      "description": "Immutable one-time reward claim record preventing duplicate mission/daily bonus claims",
      "type": "object",
      "properties": {
        "claimId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "missionId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "claimType": { "type": "string", "enum": ["first-clear", "daily-challenge"] },
        "xpEarned": { "type": "integer" },
        "coinsEarned": { "type": "integer" },
        "crystalsEarned": { "type": "integer" },
        "accuracy": { "type": "number" },
        "claimedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["claimId", "userId", "missionId", "claimType", "xpEarned", "coinsEarned", "claimedAt"]
    },
    "PredictorQuestion": {
      "title": "PredictorQuestion",
      "description": "AI-generated expected practice question requiring admin review and mandatory non-official label",
      "type": "object",
      "properties": {
        "questionId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "examYear": { "type": "integer" },
        "tier": { "type": "string", "enum": ["Tier 1", "Tier 2"] },
        "subject": { "type": "string", "enum": ["quant", "reasoning", "english", "ga", "computer"] },
        "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "questionEn": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "optionsEn": { "type": "array" },
        "correctIndex": { "type": "integer" },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "stepByStep": { "type": "array" },
        "relatedTopic": { "type": "string", "maxLength": 80 },
        "usefulnessReason": { "type": "string", "maxLength": 600 },
        "aiNoticeLabel": { "type": "string", "maxLength": 120 },
        "sourceType": { "type": "string", "enum": ["AI_GENERATED"] },
        "isOfficialPyq": { "type": "boolean" },
        "reviewStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "isPublished": { "type": "boolean" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["questionId", "examYear", "tier", "subject", "topic", "difficulty", "questionEn", "optionsEn", "correctIndex", "explanation", "aiNoticeLabel", "sourceType", "isOfficialPyq", "reviewStatus", "isPublished", "createdAt"]
    },
    "PredictorCategory": {
      "title": "PredictorCategory",
      "description": "Admin-managed topic prediction category overrides and outdated trend flags",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subject": { "type": "string", "enum": ["quant", "reasoning", "english", "ga", "computer"] },
        "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tier": { "type": "string", "enum": ["Tier 1", "Tier 2"] },
        "targetYear": { "type": "integer" },
        "priorityOverride": { "type": "string", "enum": ["Critical", "High", "Moderate", "Maintain"] },
        "isOutdated": { "type": "boolean" },
        "outdatedNote": { "type": "string", "maxLength": 400 },
        "syllabusWeightage": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["categoryId", "subject", "topic", "tier", "targetYear", "isOutdated", "updatedAt"]
    },
    "PredictionReport": {
      "title": "PredictionReport",
      "description": "Prediction accuracy report comparing predicted topics against actual imported official SSC CGL papers",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "examYear": { "type": "integer" },
        "tier": { "type": "string", "enum": ["Tier 1", "Tier 2"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "predictedTopics": { "type": "array" },
        "actualTopics": { "type": "array" },
        "matchedTopics": { "type": "array" },
        "missedTopics": { "type": "array" },
        "coveragePct": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1500 },
        "isOutdated": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["reportId", "examYear", "tier", "title", "predictedTopics", "actualTopics", "coveragePct", "isOutdated", "createdAt"]
    },
    "CurrentAffairsItem": {
      "title": "CurrentAffairsItem",
      "description": "Dated SSC CGL current affairs summary with source verification link",
      "type": "object",
      "properties": {
        "articleId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "enum": ["National", "International", "Government Schemes", "Awards & Appointments", "Science & Technology", "Economy & Reports", "Sports & Major Events"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "examRelevance": { "type": "string", "maxLength": 500 },
        "publishedDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "sourceName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceUrl": { "type": "string", "minLength": 8, "maxLength": 500 },
        "targetYear": { "type": "integer" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["articleId", "category", "title", "summary", "publishedDate", "sourceName", "sourceUrl", "targetYear", "isPublished", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private student profile & progress data"
    },
    "/usernames/{usernameId}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Unique username reservation index (contains no PII)"
    },
    "/userProgress/{userId}": {
      "schema": { "$ref": "#/entities/UserProgress" },
      "description": "Detailed per-user lesson & subject progress"
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Published SSC CGL subjects managed by admins"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Published SSC CGL courses managed by admins"
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "Published video lessons (media stored in Firebase Storage)"
    },
    "/videoLessons/{lessonId}": {
      "schema": { "$ref": "#/entities/VideoLesson" },
      "description": "Curated SSC CGL video lessons managed by admins"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/QuestionItem" },
      "description": "Curated SSC CGL PYQs & practice questions managed by admins"
    },
    "/mockTests/{testId}": {
      "schema": { "$ref": "#/entities/MockTest" },
      "description": "Published timed SSC CGL mock tests managed by admins"
    },
    "/testAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/TestAttempt" },
      "description": "Student mock test attempt records"
    },
    "/gameScores/{scoreId}": {
      "schema": { "$ref": "#/entities/GameScore" },
      "description": "Student exam game scores and accuracy records"
    },
